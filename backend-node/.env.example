# ── Entorno del Servidor ───────────────────────────
PORT=8081
NODE_ENV=development

# ── Modo Mock / SQLite para Desarrollo (Switch Rápido) ──────────────────────────
# USE_MOCK_DB=true  -> Usa SQLite local (sigpa.db) con datos simulados (sin Oracle)
# USE_MOCK_DB=false -> Usa conexión obligatoria a Oracle 10g
USE_MOCK_DB=true
SQLITE_DB_PATH=sigpa.db

# ── Configuración de Oracle Database (Requerido solo si USE_MOCK_DB=false) ─────
ORACLE_CLIENT_PATH=C:\oraclexe\instantclient_23_26
DB_USER=sigpa_admin
DB_PASSWORD=tu_password
DB_CONNECT_STRING=localhost:1521/XE

# ── Frontend estáticos ─────────────────────────────
FRONTEND_PATH=../frontend

# ── CORS ───────────────────────────────────────────
CORS_ORIGIN=*

# ── Seguridad y Autenticación JWT ───────────────────
JWT_SECRET=tu_clave_secreta_jwt_para_firmar_tokens
JWT_EXPIRES_IN=8h

